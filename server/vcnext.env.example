# Copy to /opt/vcnext_server/vcnext.env, owner root, mode 0600.
# Both services must load the SAME credential for @VCAM_V5_ADMIN_BOT.
# Replace this placeholder with a freshly rotated credential; do not commit it.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_ROTATED_TOKEN
TELEGRAM_OWNER_IDS=5137016124
# Optional: initial password for a FRESH database only. Existing hashes persist.
# Without this setting a fresh admin gets a random undisclosed password;
# use the owner-only /setpass admin command to establish its login password.
# VCNEXT_ADMIN_INITIAL_PASSWORD=PROVISION_OUT_OF_BAND
